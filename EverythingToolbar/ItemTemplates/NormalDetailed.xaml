<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:EverythingToolbar.Converters;assembly=EverythingToolbar">

    <DataTemplate x:Key="SearchResultsViewTemplate">
        <Grid>
            <Grid x:Name="FileResult" Margin="0, 0, 0, 4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image Source="{Binding Icon}"
                       Grid.RowSpan="2"
                       Width="24"
                       Height="24"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
                <ContentControl Content="{Binding HighlightedFileName, Converter={c:HighlightedTextConverter}, ConverterParameter=12, Mode=OneTime}"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Margin="0, 7, 0, 4"
                                ToolTip="{Binding FileName}"
                                Foreground="{DynamicResource SearchResultFileName}" />
                <ContentControl Content="{Binding HighlightedPath, Converter={c:HighlightedTextConverter}, ConverterParameter=10, Mode=OneTime}"
                                ToolTip="{Binding Path}"
                                Grid.Column="1"
                                Grid.Row="1"
                                VerticalAlignment="Top"
                                Margin="0, 0, 0, 4"
                                Foreground="{DynamicResource SearchResultPath}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Bottom"
                           Margin="10, 5, 10, 6"
                           FontSize="10pt"
                           Foreground="{DynamicResource SearchResultDateModified}"
                           Text="{Binding HumanReadableDateModified}" />
                <TextBlock Grid.Column="2"
                           Grid.Row="1"
                           VerticalAlignment="Top"
                           Margin="10, 0, 10, 4"
                           HorizontalAlignment="Right"
                           FontSize="10pt"
                           Foreground="{DynamicResource SearchResultFileSize}"
                           Text="{Binding HumanReadableFileSize}" />
            </Grid>
            <Grid x:Name="AiResult" Margin="0, 0, 0, 4" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="/Images/AppIcon.ico"
                       Width="24"
                       Height="24"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
                <TextBlock Text="{Binding AiResponse}"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="0, 7, 0, 4"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SearchResultFileName}" />
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsAiResult}" Value="True">
                <Setter TargetName="FileResult" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="AiResult" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>