<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:EverythingToolbar.Converters;assembly=EverythingToolbar">
    
    <DataTemplate x:Key="SearchResultsViewTemplate">
        <Grid>
            <Grid x:Name="FileResult" Margin="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}"
                       Width="16"
                       Height="16" />
                <ContentControl Content="{Binding HighlightedFileName, Converter={c:HighlightedTextConverter}, ConverterParameter=9, Mode=OneTime}"
                                Grid.Column="1"
                                Margin="2, 0"
                                ToolTip="{Binding FileName}"
                                Foreground="{DynamicResource SearchResultFileName}" />
                <TextBlock Grid.Column="2"
                           FontSize="9pt"
                           Margin="2, 0"
                           Foreground="{DynamicResource SearchResultDateModified}"
                           Text="{Binding HumanReadableDateModified}" />
            </Grid>
            <Grid x:Name="AiResult" Margin="3" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="/Images/AppIcon.ico" Width="16" Height="16" />
                <TextBlock Text="{Binding AiResponse}"
                           Grid.Column="1"
                           Margin="2, 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SearchResultFileName}" />
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsAiResult}" Value="True">
                <Setter TargetName="FileResult" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="AiResult" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    
</ResourceDictionary>